# CineMind Backend - Environment Variables
# Copy this file to .env and fill in your keys

# OpenAI API Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# (Optional fallback) Google Gemini API: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# TMDB API (The Movie Database): https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# AWS Bedrock (Optional - for AWS Builder mini-challenge)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
